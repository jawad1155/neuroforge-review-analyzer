# AMD ROCm / Developer Cloud API
AMD_RADEON_API_KEY=your_amd_radeon_api_key_here

# Database Configuration (PostgreSQL / SQLite)
DATABASE_URL=sqlite:///./neuroforge.db

# Evolus AI Agent & Workflow Platform (AMD Hackathon Partner Track)
EVOLUS_WORKSPACE_ID=your_evolus_workspace_id_here
EVOLUS_AGENT_ID=your_evolus_agent_id_here
EVOLUS_API_BASE_URL=https://api.evolus.ai/api/v1
EVOLUS_API_KEY=your_evolus_api_key_here

# Application Security
SECRET_KEY=generate_a_secure_random_key_here

# Brevo Transactional Email Service (Signup Verification Codes)
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=verify@neuroforge.ai
BREVO_SENDER_NAME=NeuroForge Security
